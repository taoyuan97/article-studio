# LLM大模型的配置
DEFAULT_LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
DEEPSEEK_CONTEXT_WINDOW=

MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=
MOONSHOT_CONTEXT_WINDOW=

# 生图大模型的配置
DEFAULT_IMAGE_PROVIDER=aliyun_wanxiang

# 阿里云通义万相
# BASE_URL 使用业务空间域名，例如 https://<workspace-id>.cn-beijing.maas.aliyuncs.com
ALIYUN_WANXIANG_API_KEY=
ALIYUN_WANXIANG_BASE_URL=
ALIYUN_WANXIANG_MODEL=wanx2.1-t2i-turbo

# 即梦 / 火山引擎
# 生图端点固定为 https://ark.cn-beijing.volces.com/api/v3/images/generations
# DREAMINA_BASE_URL 无需配置
DREAMINA_API_KEY=
DREAMINA_MODEL=doubao-seedream-5-0-lite-260128

IMAGE_TIMEOUT_SECONDS=180

LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=4096
LLM_CONTEXT_USAGE_RATIO=0.80
LLM_RECENT_MESSAGE_LIMIT=12

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=article-agent-mvp

DATA_DIR=data

# 前端托管：true 时由 FastAPI 托管 ../frontend/dist（SPA fallback）；
# 开发模式保持 false，前端走 Vite dev server（/api 经 proxy 转发）。
SERVE_FRONTEND=false
